# Aruba IMAP
IMAP_HOST=imaps.aruba.it
IMAP_PORT=993
IMAP_SECURE=true

# Aruba SMTP
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURE=true

# Mailbox 1 - Corporate / Deals
INFO_MAILBOX_USER=info@walltechgroup.eu
INFO_MAILBOX_PASSWORD=

# Mailbox 2 - Marketing / Campaigns
MARKETING_MAILBOX_USER=marketingdept@walltechgroup.eu
MARKETING_MAILBOX_PASSWORD=

# Application
APP_ENV=development
LOG_LEVEL=info

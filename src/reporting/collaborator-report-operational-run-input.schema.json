{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walltechgroup.eu/schemas/collaborator-report-operational-run-input.schema.json",
  "title": "Collaborator Report Operational Run Input v1",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "runVersion",
    "runType",
    "runPolicy",
    "reportId",
    "accountLookup",
    "mailboxPath",
    "uids",
    "collaboratorDirectory",
    "knownEvidence",
    "authoritativeUidBindings",
    "opportunityUidHints"
  ],

  "properties": {
    "runVersion": {
      "const": "1.0"
    },

    "runType": {
      "const": "COLLABORATOR_REPORT_OPERATIONAL_RUN_INPUT"
    },

    "runPolicy": {
      "const": "EXPLICIT_UID_ACQUISITION_NO_BUSINESS_INFERENCE_V1"
    },

    "reportId": {
      "type": "string",
      "minLength": 1
    },

    "accountLookup": {
      "type": "string",
      "minLength": 1
    },

    "mailboxPath": {
      "type": "string",
      "minLength": 1
    },

    "uids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },

    "collaboratorDirectory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://walltechgroup.eu/schemas/collaborator-evidence-adapter-input.schema.json#/$defs/collaboratorIdentity"
      }
    },

    "knownEvidence": {
      "type": "array",
      "items": {
        "$ref": "https://walltechgroup.eu/schemas/collaborator-reconciliation-input.schema.json#/$defs/knownEvidence"
      }
    },

    "authoritativeUidBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authoritativeUidBinding"
      }
    },

    "opportunityUidHints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opportunityUidHint"
      }
    }
  },

  "$defs": {
    "authoritativeUidBinding": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "uid",
        "opportunityId",
        "bindingSource"
      ],

      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 1
        },

        "opportunityId": {
          "type": "string",
          "minLength": 1
        },

        "bindingSource": {
          "enum": [
            "EXPLICIT_EXISTING_BINDING",
            "USER_CONFIRMED_BINDING",
            "SYSTEM_CANONICAL_BINDING"
          ]
        }
      }
    },

    "opportunityUidHint": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "uid",
        "opportunityId",
        "matchBasis"
      ],

      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 1
        },

        "opportunityId": {
          "type": "string",
          "minLength": 1
        },

        "matchBasis": {
          "enum": [
            "CONTACT_MATCH",
            "MAILBOX_SUBJECT_RELATIONSHIP",
            "USER_HINT",
            "OTHER_NON_AUTHORITATIVE"
          ]
        }
      }
    }
  }
}

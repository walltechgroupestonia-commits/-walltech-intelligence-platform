{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walltechgroup.eu/schemas/collaborator-reconciliation-input.schema.json",
  "title": "Collaborator Event Reconciliation Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reconciliationVersion",
    "reconciliationType",
    "reportId",
    "events",
    "knownEvidence",
    "authoritativeBindings",
    "candidateMatches"
  ],
  "properties": {
    "reconciliationVersion": {
      "const": "1.0"
    },
    "reconciliationType": {
      "const": "COLLABORATOR_EVENT_RECONCILIATION_INPUT"
    },
    "reportId": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "knownEvidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/knownEvidence"
      }
    },
    "authoritativeBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authoritativeBinding"
      }
    },
    "candidateMatches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidateMatch"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "collaboratorId",
        "collaboratorName",
        "occurredAt",
        "channel",
        "eventType",
        "direction",
        "sourceProvenance",
        "evidenceRef",
        "sourceSha256",
        "transportEvidenceRef",
        "operationalEligibility"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "collaboratorId": {
          "type": "string",
          "minLength": 1
        },
        "collaboratorName": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "channel": {
          "enum": [
            "EMAIL",
            "WHATSAPP",
            "PHONE",
            "MEETING",
            "WETRANSFER",
            "DOCUMENT",
            "OTHER_OPERATIONAL"
          ]
        },
        "eventType": {
          "enum": [
            "COMMUNICATION",
            "RESPONSE",
            "PHONE_NOTE",
            "MEETING",
            "DOCUMENT_SENT",
            "DOCUMENT_RECEIVED",
            "FILE_TRANSFER",
            "FOLLOW_UP"
          ]
        },
        "direction": {
          "enum": [
            "INBOUND",
            "OUTBOUND",
            "INTERNAL",
            "UNKNOWN"
          ]
        },
        "sourceProvenance": {
          "enum": [
            "DIRECT",
            "FORWARDED",
            "USER_REPORTED",
            "SYSTEM_EVIDENCE"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "transportEvidenceRef": {
          "$ref": "#/$defs/nullableString"
        },
        "mailEvidenceId": {
          "type": ["string", "null"],
          "pattern": "^ME-[a-f0-9]{64}$"
        },
        "candidateRelationshipId": {
          "type": ["string", "null"],
          "pattern": "^CCR-[a-f0-9]{64}$"
        },
        "messageId": {
          "$ref": "#/$defs/nullableString"
        },
        "operationalEligibility": {
          "enum": [
            "OPERATIONAL",
            "NOISE",
            "CONTAINER_ONLY",
            "INSUFFICIENT_EVENT"
          ]
        }
      }
    },
    "knownEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRef",
        "sourceSha256"
      ],
      "properties": {
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authoritativeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRef",
        "opportunityId",
        "bindingSource"
      ],
      "properties": {
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "opportunityId": {
          "type": "string",
          "minLength": 1
        },
        "bindingSource": {
          "enum": [
            "EXPLICIT_EXISTING_BINDING",
            "USER_CONFIRMED_BINDING",
            "SYSTEM_CANONICAL_BINDING"
          ]
        }
      }
    },
    "candidateMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "opportunityId",
        "matchBasis"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "opportunityId": {
          "type": "string",
          "minLength": 1
        },
        "matchBasis": {
          "enum": [
            "CONTACT_MATCH",
            "MAILBOX_SUBJECT_RELATIONSHIP",
            "CANDIDATE_RELATIONSHIP_ID",
            "USER_HINT",
            "OTHER_NON_AUTHORITATIVE"
          ]
        }
      }
    }
  }
}

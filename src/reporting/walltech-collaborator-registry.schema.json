{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walltechgroup.eu/schemas/walltech-collaborator-registry.schema.json",
  "title": "Walltech Collaborator Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryVersion",
    "registryType",
    "collaborators"
  ],
  "properties": {
    "registryVersion": {
      "const": "1.0"
    },
    "registryType": {
      "const": "WALLTECH_COLLABORATOR_REGISTRY"
    },
    "collaborators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collaborator"
      }
    }
  },
  "$defs": {
    "emailAddress": {
      "type": "string",
      "format": "email"
    },
    "evidenceRef": {
      "type": "string",
      "minLength": 1
    },
    "collaborator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collaboratorId",
        "displayName",
        "emailAddresses",
        "registryStatus",
        "identitySource",
        "evidenceRefs"
      ],
      "properties": {
        "collaboratorId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "emailAddresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/emailAddress"
          }
        },
        "registryStatus": {
          "enum": [
            "CANDIDATE",
            "CONFIRMED",
            "REJECTED"
          ]
        },
        "identitySource": {
          "enum": [
            "MAIL_EVIDENCE",
            "USER_CONFIRMED_DIRECTORY"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    }
  }
}

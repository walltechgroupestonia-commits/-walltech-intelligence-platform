{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walltechgroup.eu/schemas/mail-account-registry.schema.json",
  "title": "Walltech Mail Account Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryVersion",
    "registryType",
    "accounts"
  ],
  "properties": {
    "registryVersion": {
      "const": "1.0"
    },
    "registryType": {
      "const": "MAIL_ACCOUNT_REGISTRY"
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/account"
      }
    }
  },
  "$defs": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountKey",
        "mailboxUser",
        "provider",
        "providerAccountKey",
        "providerAdapter",
        "activationStatus",
        "defaultMailboxPaths",
        "routingAddresses",
        "upstreamPipelineReuse"
      ],
      "properties": {
        "accountKey": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "mailboxUser": {
          "type": "string",
          "format": "email"
        },
        "provider": {
          "type": "string",
          "enum": [
            "ARUBA_IMAP",
            "GMAIL_IMAP"
          ]
        },
        "providerAccountKey": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "providerAdapter": {
          "type": "string",
          "enum": [
            "ARUBA_EXISTING_V1",
            "GMAIL_PENDING_V1"
          ]
        },
        "activationStatus": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "CONFIGURED_PENDING_VALIDATION",
            "CONFIGURED_PENDING_PROVIDER_ADAPTER"
          ]
        },
        "defaultMailboxPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "routingAddresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "upstreamPipelineReuse": {
          "const": true
        }
      }
    }
  }
}

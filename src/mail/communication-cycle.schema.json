{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Walltech Communication Cycle",
  "type": "object",
  "required": [
    "dealId",
    "dealName",
    "source",
    "mailbox",
    "status",
    "priority",
    "currentBlocker",
    "nextAction"
  ],
  "properties": {
    "dealId": {
      "type": "string"
    },
    "dealName": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "mailbox": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "NEW",
        "ACTIVE",
        "WAITING_ON_WALLTECH",
        "WAITING_ON_COUNTERPARTY",
        "WAITING_ON_SUPPLIER",
        "BLOCKED",
        "QUALIFIED",
        "QUOTATION",
        "NEGOTIATION",
        "CONTRACT",
        "EXCHANGE",
        "CLOSED_WON",
        "CLOSED_LOST",
        "PARKED"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "primaryContact": {
      "type": "object"
    },
    "otherContacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commercialValue": {
      "type": [
        "number",
        "null"
      ]
    },
    "feeValue": {
      "type": [
        "number",
        "null"
      ]
    },
    "revenueStatus": {
      "type": "string"
    },
    "marginStatus": {
      "type": "string"
    },
    "lastCounterpartyResponseDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "walltechFollowUps": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "missingCommercialData": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "currentBlocker": {
      "type": "string"
    },
    "nextAction": {
      "type": "string"
    },
    "timeToRevenueStatus": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lifecyclePhase": {
      "type": "string",
      "enum": [
        "START",
        "CHANGE",
        "STOP"
      ]
    },
    "controlStatus": {
      "type": "string",
      "enum": [
        "IN_CONTROL",
        "WAITING_EXTERNAL",
        "ACTION_REQUIRED",
        "BLOCKED",
        "OUT_OF_CONTROL",
        "NOT_APPLICABLE"
      ]
    },
    "stopOutcome": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "MONETIZED",
        "NO_GO",
        null
      ]
    },
    "stopReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastEvidenceAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastActionAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "nextActionDueAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "stoppedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "invoiceIssuedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "paymentReceivedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "assignedCollaboratorIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reportRecipientCollaboratorIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "lifecyclePhase"
        ],
        "properties": {
          "lifecyclePhase": {}
        }
      },
      "then": {
        "required": [
          "controlStatus",
          "stopOutcome",
          "stopReason",
          "startedAt",
          "lastEvidenceAt",
          "lastActionAt",
          "nextActionDueAt",
          "updatedAt",
          "stoppedAt",
          "invoiceIssuedAt",
          "paymentReceivedAt",
          "assignedCollaboratorIds",
          "reportRecipientCollaboratorIds"
        ],
        "properties": {
          "controlStatus": {},
          "stopOutcome": {},
          "stopReason": {},
          "startedAt": {},
          "lastEvidenceAt": {},
          "lastActionAt": {},
          "nextActionDueAt": {},
          "updatedAt": {},
          "stoppedAt": {},
          "invoiceIssuedAt": {},
          "paymentReceivedAt": {},
          "assignedCollaboratorIds": {},
          "reportRecipientCollaboratorIds": {}
        }
      }
    },
    {
      "if": {
        "required": [
          "lifecyclePhase"
        ],
        "properties": {
          "lifecyclePhase": {
            "const": "START"
          }
        }
      },
      "then": {
        "properties": {
          "controlStatus": {
            "enum": [
              "IN_CONTROL",
              "ACTION_REQUIRED",
              "BLOCKED"
            ]
          },
          "status": {
            "not": {
              "enum": [
                "CLOSED_WON",
                "CLOSED_LOST"
              ]
            }
          },
          "stopOutcome": {
            "const": null
          },
          "stopReason": {
            "const": null
          },
          "stoppedAt": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "lifecyclePhase"
        ],
        "properties": {
          "lifecyclePhase": {
            "const": "CHANGE"
          }
        }
      },
      "then": {
        "properties": {
          "controlStatus": {
            "enum": [
              "IN_CONTROL",
              "WAITING_EXTERNAL",
              "ACTION_REQUIRED",
              "BLOCKED",
              "OUT_OF_CONTROL"
            ]
          },
          "status": {
            "not": {
              "enum": [
                "CLOSED_WON",
                "CLOSED_LOST"
              ]
            }
          },
          "stopOutcome": {
            "const": null
          },
          "stopReason": {
            "const": null
          },
          "stoppedAt": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "lifecyclePhase"
        ],
        "properties": {
          "lifecyclePhase": {
            "const": "STOP"
          }
        }
      },
      "then": {
        "properties": {
          "controlStatus": {
            "const": "NOT_APPLICABLE"
          },
          "stopOutcome": {
            "enum": [
              "MONETIZED",
              "NO_GO"
            ]
          },
          "stoppedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "lifecyclePhase",
          "stopOutcome"
        ],
        "properties": {
          "lifecyclePhase": {
            "const": "STOP"
          },
          "stopOutcome": {
            "const": "MONETIZED"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "CLOSED_WON"
          },
          "stopReason": {
            "const": null
          },
          "invoiceIssuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "paymentReceivedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "lifecyclePhase",
          "stopOutcome"
        ],
        "properties": {
          "lifecyclePhase": {
            "const": "STOP"
          },
          "stopOutcome": {
            "const": "NO_GO"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "CLOSED_LOST"
          },
          "stopReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walltechgroup.eu/schemas/communication-cycle-detection.schema.json",
  "title": "Walltech Communication Cycle Detection Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detectionVersion",
    "detectionType",
    "source",
    "messageCount",
    "messages",
    "candidateRelationshipCount",
    "candidateRelationships",
    "generatedAt"
  ],
  "properties": {
    "detectionVersion": {
      "const": "1.0"
    },
    "detectionType": {
      "const": "COMMUNICATION_CYCLE_CANDIDATES"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountKey",
        "mailboxUser",
        "provider",
        "evidenceCount"
      ],
      "properties": {
        "accountKey": {
          "type": "string",
          "minLength": 1
        },
        "mailboxUser": {
          "type": "string",
          "format": "email"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "messageCount": {
      "type": "integer",
      "minimum": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/messageSignal"
      }
    },
    "candidateRelationshipCount": {
      "type": "integer",
      "minimum": 1
    },
    "candidateRelationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidateRelationship"
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "evidenceId": {
      "type": "string",
      "pattern": "^ME-[a-f0-9]{64}$"
    },
    "relationshipId": {
      "type": "string",
      "pattern": "^CCR-[a-f0-9]{64}$"
    },
    "direction": {
      "type": "string",
      "enum": [
        "INBOUND",
        "OUTBOUND",
        "SELF",
        "AMBIGUOUS"
      ]
    },
    "emailArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "email"
      }
    },
    "evidenceIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceId"
      }
    },
    "messageSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "mailboxPath",
        "uidValidity",
        "uid",
        "messageId",
        "date",
        "subject",
        "subjectKey",
        "direction",
        "externalAddresses"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/evidenceId"
        },
        "mailboxPath": {
          "type": "string",
          "minLength": 1
        },
        "uidValidity": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "messageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "subjectKey": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "externalAddresses": {
          "$ref": "#/$defs/emailArray"
        }
      }
    },
    "candidateRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateRelationshipId",
        "subjectKey",
        "evidenceIds",
        "externalAddresses",
        "directionsObserved",
        "messageCount",
        "inboundCount",
        "outboundCount",
        "selfCount",
        "ambiguousCount",
        "exchangeObserved"
      ],
      "properties": {
        "candidateRelationshipId": {
          "$ref": "#/$defs/relationshipId"
        },
        "subjectKey": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIdArray"
        },
        "externalAddresses": {
          "$ref": "#/$defs/emailArray"
        },
        "directionsObserved": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/direction"
          }
        },
        "messageCount": {
          "type": "integer",
          "minimum": 1
        },
        "inboundCount": {
          "type": "integer",
          "minimum": 0
        },
        "outboundCount": {
          "type": "integer",
          "minimum": 0
        },
        "selfCount": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguousCount": {
          "type": "integer",
          "minimum": 0
        },
        "exchangeObserved": {
          "type": "boolean"
        }
      }
    }
  }
}
